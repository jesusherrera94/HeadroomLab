import { Button, VerticalBox } from "std-widgets.slint";

// One quadrant of the graph grid: a rendered plot image plus scroll-to-zoom /
// drag-to-pan / reset-view interaction. The owner binds `view_start`/`view_end`
// with a two-way alias (`<=>`) so panning and zooming here are reflected back
// without a separate callback.
component PlotPane inherits VerticalLayout {
    in property <string> title;
    in property <image> source;
    in-out property <float> view_start;
    in-out property <float> view_end;
    in property <float> full_start;
    in property <float> full_end;

    spacing: 4px;

    Text { text: root.title; font-size: 12px; color: #cccccc; }

    Rectangle {
        height: 300px;
        background: #111118;
        border-color: #333;
        border-width: 1px;

        Image {
            source: root.source;
            width: 100%;
            height: 100%;
        }

        TouchArea {
            property <float> pressed_start;
            property <float> pressed_end;

            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    self.pressed_start = root.view_start;
                    self.pressed_end = root.view_end;
                }
            }
            moved => {
                if (self.enabled && self.pressed) {
                    let span = self.pressed_end - self.pressed_start;
                    let shift = -(self.mouse-x - self.pressed-x) / self.width * span;
                    root.view_start = self.pressed_start + shift;
                    root.view_end = self.pressed_end + shift;
                }
            }
            scroll-event(event) => {
                let span = root.view_end - root.view_start;
                let factor = event.delta-y > 0px ? 0.9 : 1.1;
                let full_span = root.full_end - root.full_start;
                let min_span = full_span / 200;
                let new_span = max(span * factor, min_span);
                let center = (root.view_start + root.view_end) / 2;
                root.view_start = center - new_span / 2;
                root.view_end = center + new_span / 2;
                accept
            }
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        }
    }

    Button {
        text: "Reset view";
        clicked => {
            root.view_start = root.full_start;
            root.view_end = root.full_end;
        }
    }
}

export component GraphWindow inherits Window {
    title: "HeadroomLab - Signal Graph";
    width: 1040px;
    height: 760px;

    // Bumped by graph_controller after every recompute. The render_* pure
    // callbacks take this as an argument purely to force Slint to re-invoke
    // them, since the underlying signal data lives in Rust state outside
    // Slint's own reactivity graph.
    in-out property <int> data_version: 0;

    in-out property <bool> has_processed: false;
    in-out property <string> processed_status: "";

    in-out property <float> orig_time_start: 0;
    in-out property <float> orig_time_end: 1;
    in-out property <float> orig_time_full_end: 1;
    in-out property <float> orig_freq_start: 20;
    in-out property <float> orig_freq_end: 24000;

    in-out property <float> proc_time_start: 0;
    in-out property <float> proc_time_end: 1;
    in-out property <float> proc_freq_start: 20;
    in-out property <float> proc_freq_end: 24000;

    pure callback render_original_time(float, float, int) -> image;
    pure callback render_original_freq(float, float, int) -> image;
    pure callback render_processed_time(float, float, int) -> image;
    pure callback render_processed_freq(float, float, int) -> image;

    VerticalBox {
        Text { text: "Signal Graph"; font-size: 16px; font-weight: 800; }

        GridLayout {
            spacing: 12px;
            Row {
                PlotPane {
                    title: "Original — Time domain";
                    source: root.render_original_time(root.orig_time_start, root.orig_time_end, root.data_version);
                    view_start <=> root.orig_time_start;
                    view_end <=> root.orig_time_end;
                    full_start: 0;
                    full_end: root.orig_time_full_end;
                }
                PlotPane {
                    title: "Original — Frequency domain";
                    source: root.render_original_freq(root.orig_freq_start, root.orig_freq_end, root.data_version);
                    view_start <=> root.orig_freq_start;
                    view_end <=> root.orig_freq_end;
                    full_start: 20;
                    full_end: 24000;
                }
            }
            Row {
                PlotPane {
                    title: "Processed — Time domain";
                    source: root.render_processed_time(root.proc_time_start, root.proc_time_end, root.data_version);
                    view_start <=> root.proc_time_start;
                    view_end <=> root.proc_time_end;
                    full_start: 0;
                    full_end: root.orig_time_full_end;
                }
                PlotPane {
                    title: "Processed — Frequency domain";
                    source: root.render_processed_freq(root.proc_freq_start, root.proc_freq_end, root.data_version);
                    view_start <=> root.proc_freq_start;
                    view_end <=> root.proc_freq_end;
                    full_start: 20;
                    full_end: 24000;
                }
            }
        }

        if !root.has_processed: Text {
            text: root.processed_status == "" ? "No effect loaded — showing original signal only." : root.processed_status;
            color: #c0392b;
            font-size: 11px;
        }
    }
}
