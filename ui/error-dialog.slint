import { Button } from "std-widgets.slint";

export component ErrorDialog inherits Rectangle {
    in property <string> message;
    callback dismissed();

    background: #000000aa;

    // Swallow clicks aimed at the controls behind the modal.
    TouchArea { }

    Rectangle {
        width: 420px;
        height: 160px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #1e1e1e;
        border-color: #c0392b;
        border-width: 2px;
        border-radius: 6px;

        VerticalLayout {
            padding: 20px;
            spacing: 16px;
            alignment: start;

            Text {
                text: "Error";
                font-size: 14px;
                font-weight: 700;
                color: #c0392b;
            }
            Text {
                text: root.message;
                font-size: 12px;
                color: #cccccc;
                wrap: word-wrap;
            }
            Button {
                text: "Dismiss";
                clicked => { root.dismissed(); }
            }
        }
    }
}
