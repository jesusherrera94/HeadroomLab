import { Button, Slider, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { ErrorDialog } from "error-dialog.slint";

// A single knob: label + 0..1 slider. Emits (index, value).
component Knob inherits VerticalLayout {
    in property <string> label;
    in property <int> index;
    callback changed(int, float);
    spacing: 4px;

    Text {
        text: root.label;
        color: #cccccc;
        font-size: 11px;
        horizontal-alignment: center;
    }
    Slider {
        minimum: 0.0;
        maximum: 1.0;
        value: 0.0;
        changed(v) => { root.changed(root.index, v); }
    }
}

// A 3-step toggle switch (UP / MIDDLE / DOWN). Emits (index, position).
component ThreeWaySwitch inherits VerticalLayout {
    in property <string> label;
    in property <int> index;
    property <int> position: 1; // default MIDDLE
    callback changed(int, int);
    spacing: 4px;

    Text {
        text: root.label;
        color: #cccccc;
        font-size: 11px;
    }
    HorizontalLayout {
        spacing: 4px;
        Button {
            text: "UP";
            primary: root.position == 0;
            clicked => { root.position = 0; root.changed(root.index, 0); }
        }
        Button {
            text: "MID";
            primary: root.position == 1;
            clicked => { root.position = 1; root.changed(root.index, 1); }
        }
        Button {
            text: "DN";
            primary: root.position == 2;
            clicked => { root.position = 2; root.changed(root.index, 2); }
        }
    }
}

// A footswitch toggle button. Emits (index, pressed).
component Footswitch inherits VerticalLayout {
    in property <string> label;
    in property <int> index;
    property <bool> pressed: false;
    callback changed(int, bool);

    Button {
        text: root.pressed ? (root.label + " [ON]") : (root.label + " [OFF]");
        primary: root.pressed;
        clicked => { root.pressed = !root.pressed; root.changed(root.index, root.pressed); }
    }
}

export component SimulatorWindow inherits Window {
    title: "HeadroomLab - Hardware Simulator";
    width: 640px;
    height: 640px;

    in-out property <bool> has_audio: false;
    in-out property <bool> is_playing: false;
    in-out property <bool> is_bypassed: false;
    in-out property <float> current_time: 0.0;
    in-out property <float> duration: 0.0;
    in-out property <string> error_message: "";
    in-out property <bool> show_error: false;

    callback upload_audio();
    callback toggle_play();
    callback toggle_bypass();
    callback open_graph();
    callback seek_audio(float);
    callback knob_changed(int, float);
    callback switch_changed(int, int);
    callback footswitch_changed(int, bool);
    callback error_dismissed();

    VerticalBox {
        spacing: 15px;

        Text {
            text: "Audio Player";
            font-size: 16px;
            font-weight: 800;
        }

        HorizontalBox {
            Button {
                text: "Upload Audio";
                clicked => { root.upload_audio() }
            }
            Button {
                text: root.is_playing ? "Stop" : "Play";
                enabled: root.has_audio;
                clicked => { root.toggle_play() }
            }
            Button {
                text: root.is_bypassed ? "Bypassed [ON]" : "Bypass [OFF]";
                enabled: root.has_audio;
                clicked => { root.toggle_bypass() }
            }
            Button {
                text: "View graph";
                enabled: root.has_audio;
                clicked => { root.open_graph() }
            }
        }

        HorizontalBox {
            Text { text: round(root.current_time) + "s"; vertical-alignment: center; }
            Slider {
                minimum: 0.0;
                maximum: root.duration;
                value: root.current_time;
                enabled: root.has_audio;
                changed(val) => { root.seek_audio(val); }
            }
            Text { text: round(root.duration) + "s"; vertical-alignment: center; }
        }

        // Simulated Hothouse hardware controls.
        Rectangle {
            background: #1a1a2e;
            border-color: #444;
            border-width: 1px;
            border-radius: 4px;

            VerticalLayout {
                padding: 12px;
                spacing: 12px;
                alignment: start;

                Text {
                    text: "Hothouse Hardware";
                    color: #ffffff;
                    font-size: 14px;
                    font-weight: 700;
                }

                Text { text: "Knobs"; color: #888888; font-size: 11px; }
                HorizontalLayout {
                    spacing: 8px;
                    Knob { label: "Knob 1"; index: 0; changed(i, v) => { root.knob_changed(i, v); } }
                    Knob { label: "Knob 2"; index: 1; changed(i, v) => { root.knob_changed(i, v); } }
                    Knob { label: "Knob 3"; index: 2; changed(i, v) => { root.knob_changed(i, v); } }
                    Knob { label: "Knob 4"; index: 3; changed(i, v) => { root.knob_changed(i, v); } }
                    Knob { label: "Knob 5"; index: 4; changed(i, v) => { root.knob_changed(i, v); } }
                    Knob { label: "Knob 6"; index: 5; changed(i, v) => { root.knob_changed(i, v); } }
                }

                Text { text: "Switches"; color: #888888; font-size: 11px; }
                HorizontalLayout {
                    spacing: 16px;
                    ThreeWaySwitch { label: "SW 1"; index: 0; changed(i, p) => { root.switch_changed(i, p); } }
                    ThreeWaySwitch { label: "SW 2"; index: 1; changed(i, p) => { root.switch_changed(i, p); } }
                    ThreeWaySwitch { label: "SW 3"; index: 2; changed(i, p) => { root.switch_changed(i, p); } }
                }

                Text { text: "Footswitches"; color: #888888; font-size: 11px; }
                HorizontalLayout {
                    spacing: 16px;
                    Footswitch { label: "FS 1"; index: 0; changed(i, p) => { root.footswitch_changed(i, p); } }
                    Footswitch { label: "FS 2"; index: 1; changed(i, p) => { root.footswitch_changed(i, p); } }
                }
            }
        }
    }

    if root.show_error: ErrorDialog {
        width: 100%;
        height: 100%;
        message: root.error_message;
        dismissed => {
            root.show_error = false;
            root.error_dismissed();
        }
    }
}
